---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

          <!-- TÍTULO -->
          <div class="lg:col-span-4">

            <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-6xl font-bold text-gray-900">
              Educación
            </h2>

            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />

          </div>

          <!-- CONTENIDO -->
          <div class="lg:col-span-8">

            <div class="space-y-8">

              {siteConfig.education.map((edu) => (

                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">

                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">

                    <div>

                      <!-- ETIQUETA EDUCACIÓN COMPLEMENTARIA -->
                      {
                        edu.complementary && (
                          <span class="inline-block mb-2 mr-2 px-3 py-1 text-xs font-semibold tracking-wide uppercase rounded-full bg-gray-200 text-gray-700">
                            Educación Complementaria
                          </span>
                        )
                      }

                      <!-- ETIQUETA CAPACITACIÓN -->
                      {
                        edu.training && (
                          <span
                            class="inline-block mb-2 px-3 py-1 text-xs font-semibold tracking-wide uppercase rounded-full text-white"
                            style={`background-color: ${siteConfig.accentColor}`}
                          >
                            Capacitación
                          </span>
                        )
                      }

                      <!-- TÍTULO -->
                      <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                        {edu.degree}
                      </h3>

                      <!-- UNIVERSIDAD -->
                      <p
                        class="text-base sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {edu.school}
                      </p>

                    </div>

                    <!-- FECHA -->
                    <span class="text-xs sm:text-sm text-gray-500 mt-2 sm:mt-0">
                      {edu.dateRange}
                    </span>

                  </div>

                  <!-- DESCRIPCIÓN -->
                  <ul class="space-y-2">

                    {edu.achievements.map((achievement) => (

                      <li class="flex items-start">

                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />

                        <span class="text-sm sm:text-base text-gray-600">
                          {achievement}
                        </span>

                      </li>

                    ))}

                  </ul>

                  <!-- TESIS DINÁMICA -->
                  {
                    edu.thesisTitle && (
                      <div class="mt-6 p-4 rounded-lg bg-gray-50 border border-gray-200">

                        <h4
                          class="text-sm sm:text-base font-semibold mb-3"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {edu.thesisLabel || "Tesis"}
                        </h4>

                        <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
                          <strong>
                            “{edu.thesisTitle}”
                          </strong>
                        </p>

                        {
                          edu.thesisAuthors && (
                            <p class="mt-3 text-sm text-gray-600">
                              <strong>Autores:</strong> {edu.thesisAuthors}
                            </p>
                          )
                        }

                        {
                          edu.thesisDirector && (
                            <p class="mt-1 text-sm text-gray-600">
                              <strong>Director:</strong> {edu.thesisDirector}
                            </p>
                          )
                        }

                        {
                          edu.thesisDate && (
                            <p class="mt-1 text-sm text-gray-600">
                              <strong>Fecha:</strong> {edu.thesisDate}
                            </p>
                          )
                        }

                        {
                          edu.thesisLink && (
                            <a
                              href={edu.thesisLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-2 mt-4 text-sm font-medium hover:underline"
                              style={`color: ${siteConfig.accentColor}`}
                            >
                              Ver documento completo

                              <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M7 17L17 7M17 7H7M17 7V17"
                                />
                              </svg>

                            </a>
                          )
                        }

                      </div>
                    )
                  }

                </div>

              ))}

            </div>

          </div>

        </div>

      </div>
    </section>
  )
}
