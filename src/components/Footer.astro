---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<footer class="bg-white border-t border-gray-200 mt-16">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <!-- Información -->
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold text-gray-800">
          {siteConfig.name}
        </h3>

        <p class="text-base text-gray-600">
          {siteConfig.title}
        </p>

        <!-- Redes -->
        <div class="flex gap-x-6">
          <a
            href={`mailto:${siteConfig.social.email}`}
            aria-label="Correo"
            class="text-gray-600 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            ✉️
          </a>

          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-600 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            LinkedIn
          </a>

          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-gray-600 transition-colors duration-300 hover:text-[var(--accent-color)]"
            style={`--accent-color: ${siteConfig.accentColor}`}
          >
            GitHub
          </a>
        </div>
      </div>

      <!-- Navegación -->
      <div class="flex flex-col md:items-end gap-4">
        <nav class="flex flex-wrap gap-x-8 gap-y-2 justify-center">
          <a
            href="#about"
            class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
          >
            Sobre mí
          </a>

          {
            hasEducation && (
              <a
                href="#education"
                class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
              >
                Educación
              </a>
            )
          }

          {
            hasExperience && (
              <a
                href="#experience"
                class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
              >
                Experiencia
              </a>
            )
          }

          {
            hasProjects && (
              <a
                href="#projects"
                class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
              >
                Proyectos de Investigación
              </a>
            )
          }
        </nav>

        <p class="text-sm text-gray-500 text-center md:text-right">
          © {new Date().getFullYear()}
          {siteConfig.name}. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </div>
</footer>
