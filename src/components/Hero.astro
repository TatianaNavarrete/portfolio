---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white py-24 md:min-h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Fondo -->
  <div
    class="absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${siteConfig.accentColor}40 0%, ${siteConfig.accentColor}25 20%, ${siteConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
  >
  </div>

  <!-- Patrón -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="grid-pattern"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>

      <pattern
        id="legal-symbols"
        x="0"
        y="0"
        width="420"
        height="420"
        patternUnits="userSpaceOnUse"
      >
        <text
          x="50"
          y="70"
          fill={siteConfig.accentColor}
          font-family="serif"
          font-size="24"
          transform="rotate(-12)">§</text>

        <text
          x="160"
          y="120"
          fill={siteConfig.accentColor}
          font-family="serif"
          font-size="20"
          transform="rotate(10)">LEX</text>

        <text
          x="270"
          y="90"
          fill={siteConfig.accentColor}
          font-family="serif"
          font-size="20"
          transform="rotate(-5)">⚖</text>

        <text
          x="90"
          y="230"
          fill={siteConfig.accentColor}
          font-family="serif"
          font-size="22"
          transform="rotate(15)">ART.</text>

        <text
          x="300"
          y="220"
          fill={siteConfig.accentColor}
          font-family="serif"
          font-size="20"
          transform="rotate(-10)">IUS</text>

        <text
          x="200"
          y="300"
          fill={siteConfig.accentColor}
          font-family="serif"
          font-size="24"
          transform="rotate(5)">⚖</text>
      </pattern>
    </defs>

    <rect
      fill="url(#legal-symbols)"
      width="100%"
      height="100%"
      opacity="0.14"></rect>

    <rect
      fill="url(#grid-pattern)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>

  <!-- CONTENIDO -->
  <div class="mx-auto p-8 sm:p-12 md:p-24 flex items-center">

    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">

      <!-- FOTO -->
      {
        siteConfig.profileImage && (
          <img
            src={siteConfig.profileImage}
            alt={siteConfig.name}
            class="w-48 h-48 sm:w-56 sm:h-56 md:w-72 md:h-72 rounded-full object-cover border-4 bg-white shadow-2xl animate-fade-in"
            style={`border-color: ${siteConfig.accentColor}`}
          />
        )
      }

      <!-- TEXTO -->
      <div class="text-center md:text-left">

        <h2
          class="text-pretty text-xl sm:text-2xl md:text-5xl font-bold tracking-tight text-gray-700 animate-fade-in"
        >
          ¡Bienvenidos! 👋
        </h2>

        <h1
          class="mt-6 sm:mt-8 md:mt-10 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-gray-800 animate-fade-in animation-delay-200"
        >
          Soy
          <span style={{ color: siteConfig.accentColor }}>
            {siteConfig.name}
          </span>
        </h1>

        <p
          class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 animate-fade-in animation-delay-400"
        >
          {siteConfig.title}
        </p>

        <!-- CORREO -->
        <div class="mt-4 animate-fade-in animation-delay-400">

          <a
            href="mailto:tatiananavarrete2490@gmail.com"
            class="text-base sm:text-lg md:text-xl text-gray-700 hover:text-[var(--accent-color)] transition-colors duration-300 font-medium"
          >
            ✉️ tatiananavarrete2490@gmail.com
          </a>

        </div>

        <!-- BOTÓN PDF -->
        <div class="mt-8 animate-fade-in animation-delay-600">

          <a
            href="/portfolio/CV_Lisseth_Navarrete.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 rounded-xl text-white font-semibold shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl"
            style={`background-color: ${siteConfig.accentColor}`}
          >
            Descargar Hoja de Vida
          </a>

        </div>

        <!-- ICONOS -->
        <div
          class="mt-8 flex justify-center md:justify-start gap-x-8 text-gray-700 animate-fade-in animation-delay-600"
        >

          <!-- EMAIL -->
          {
            siteConfig.social?.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Correo electrónico"
                class="transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-7 w-7 md:h-8 md:w-8"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }

          <!-- LINKEDIN -->
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-7 w-7 md:h-8 md:w-8"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }

          <!-- ORCID -->
          {
            siteConfig.social?.orcid && (
              <a
                href={siteConfig.social.orcid}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="ORCID"
                class="transition-colors duration-300 hover:text-[var(--accent-color)] text-lg font-semibold"
              >
                ORCID
              </a>
            )
          }

        </div>

      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
</style>
